# Copy to `.env` for production (`config.settings.prod`).
# Never commit real secrets.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example

# PostgreSQL (recommended for production):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Explicit SQLite option for a disposable staging environment only:
# DATABASE_URL=sqlite:///./db.sqlite3

# Optional TLS / reverse proxy
DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_USE_X_FORWARDED_PROTO=1

# Celery (Phase D2); defaults suit local Redis
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Integration backends (dotted class paths); defaults are no-op
# INTEGRATIONS_SMS_BACKEND=apps.integrations.backends.LogSmsBackend
# INTEGRATIONS_MOMO_BACKEND=apps.integrations.backends.SandboxMoMoBackend

# Comma-separated HTTPS origins, only when required by your deployment
# DJANGO_CSRF_TRUSTED_ORIGINS=https://clinic.example.com
# Enable HSTS only after verifying HTTPS; start with a short duration
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0
